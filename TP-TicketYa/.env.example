# Variables locales de ejemplo. Copiar a .env solo si hace falta.
# docker-compose.dev.yml ya trae valores por defecto para desarrollo.
# docker-compose.yml (integral) interpola de acá: JWT_SECRET, JWT_TTL,
# INTERNAL_TOKEN, QUEUE_TOKEN_SECRET, QUEUE_BATCH_SIZE, QUEUE_INTERVAL_SECONDS
# y QUEUE_SCHEDULER_MS (si no hay .env, usa los defaults de desarrollo).

# Bases de datos (puertos publicados por docker-compose.dev.yml).
# Cada servicio lee DB_URL; al correr con Maven, exportar el valor que corresponde
# en la terminal de ese servicio (los defaults ya apuntan al puerto correcto):
#   catalog-service      DB_URL=jdbc:postgresql://localhost:5433/catalog_db
#   inventory-service    DB_URL=jdbc:postgresql://localhost:5434/inventory_db
#   orders-service       DB_URL=jdbc:postgresql://localhost:5435/orders_db
# notification-service usa su propia variable:
NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5436/notification_db
DB_USER=ticketya
DB_PASSWORD=ticketya
# Pool de orders e inventory (la prueba de carga de 1000 usuarios necesita más de 10)
DB_POOL_SIZE=40
DB_CONNECTION_TIMEOUT_MS=5000

# MongoDB de recommendation-service (puerto publicado por docker-compose.dev.yml)
MONGO_URI=mongodb://localhost:27017/recommendation_db
# Token compartido para los endpoints /internal/** de todos los servicios
INTERNAL_TOKEN=ticketya-internal-dev
# Desactivar el seed de preferencias/historial en entornos que no son de desarrollo
RECOMMENDATION_SEED_ENABLED=true
# Consumidor de orden.pagada y timeouts del cliente de catalog
RECOMMENDATION_QUEUE=recommendation.history
RECOMMENDATION_CONSUMER_MAX_ATTEMPTS=3
CATALOG_CONNECT_TIMEOUT_MS=2000
CATALOG_READ_TIMEOUT_MS=3000
# notification reintenta antes de mandar a la DLQ
NOTIFICATION_CONSUMER_MAX_ATTEMPTS=3

# RabbitMQ (topología de colas definida en la tarea 1.5)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=ticketya
RABBITMQ_PASSWORD=ticketya

# Servicios
CATALOG_URL=http://localhost:8081
INVENTORY_URL=http://localhost:8082
ORDERS_URL=http://localhost:8083
RECOMMENDATION_URL=http://localhost:8084
NOTIFICATION_URL=http://localhost:8085
QUEUE_URL=http://localhost:8086

# Redis de la fila virtual
REDIS_HOST=localhost
REDIS_PORT=6379
QUEUE_TOKEN_SECRET=ticketya-queue-dev-secret-key-32b
QUEUE_BATCH_SIZE=50
QUEUE_INTERVAL_SECONDS=30
QUEUE_SCHEDULER_MS=5000
QUEUE_SCHEDULER_ENABLED=true
QUEUE_TOKEN_TTL=5m
# Frecuencia de los jobs de catalog e inventory
CATALOG_SCHEDULER_FINALIZACION_MS=60000
INVENTORY_VENCIMIENTO_MS=30000

# JWT del gateway (en producción el secreto real va por variable de entorno, no se commitea)
JWT_SECRET=ticketya-dev-secret-change-me-32-bytes-min!!
JWT_TTL=8h

# Orígenes permitidos por CORS en el gateway (separados por coma). Nunca "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
