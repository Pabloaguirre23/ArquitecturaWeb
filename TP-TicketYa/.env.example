# Variables locales de ejemplo. Copiar a .env solo si hace falta.
# docker-compose.dev.yml ya trae valores por defecto para desarrollo.

# Bases de datos (puertos publicados por docker-compose.dev.yml)
CATALOG_DB_URL=jdbc:postgresql://localhost:5433/catalog_db
INVENTORY_DB_URL=jdbc:postgresql://localhost:5434/inventory_db
ORDERS_DB_URL=jdbc:postgresql://localhost:5435/orders_db
DB_USER=ticketya
DB_PASSWORD=ticketya

# MongoDB de recommendation-service (puerto publicado por docker-compose.dev.yml)
MONGO_URI=mongodb://localhost:27017/recommendation_db
# Token compartido para los endpoints /internal/** de todos los servicios
INTERNAL_TOKEN=ticketya-internal-dev
# Desactivar el seed de preferencias/historial en entornos que no son de desarrollo
RECOMMENDATION_SEED_ENABLED=true

# Servicios
CATALOG_URL=http://localhost:8081
INVENTORY_URL=http://localhost:8082
ORDERS_URL=http://localhost:8083
RECOMMENDATION_URL=http://localhost:8084
