# URLs y modo de la interfaz
# En desarrollo Vite hace proxy de /api al gateway.
VITE_API_URL=/api
VITE_GATEWAY_URL=http://localhost:8080

# true: datos de ejemplo en memoria (no requiere backend)
# false: consume el gateway real
VITE_USE_MOCKS=true

# Credenciales sugeridas en modo demo
VITE_DEMO_EMAIL=cliente@ticketya.test
VITE_DEMO_PASSWORD=demo
