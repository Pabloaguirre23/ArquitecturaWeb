{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "inventory-service",
    "description" : "Disponibilidad, reservas temporales y no doble venta de TicketYa.\nLos errores usan application/problem+json (RFC 7807) con `code` y `errors`.\nCódigos de esta API: 200, 201, 204, 400, 401, 403, 404, 409, 410 y 422.\n",
    "version" : "1.0.0"
  },
  "servers" : [ {
    "url" : "http://localhost:8082",
    "description" : "inventory-service"
  } ],
  "tags" : [ {
    "name" : "Inventario interno",
    "description" : "Llamadas de catalog y orders. El gateway no las expone."
  }, {
    "name" : "Inventario público",
    "description" : "Disponibilidad, mapa de asientos y reservas del cliente."
  } ],
  "paths" : {
    "/internal/returns" : {
      "post" : {
        "tags" : [ "Inventario interno" ],
        "summary" : "Devolver lugares",
        "description" : "Devuelve un asiento vendido o repone una zona. Idempotente con Idempotency-Key.",
        "operationId" : "devolver",
        "parameters" : [ {
          "name" : "Idempotency-Key",
          "in" : "header",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ReturnRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "Lugares devueltos"
          },
          "404" : {
            "description" : "No existe el sector",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },
    "/internal/reservations/{reservaId}/release" : {
      "post" : {
        "tags" : [ "Inventario interno" ],
        "summary" : "Liberar una reserva",
        "description" : "Libera la reserva si el pago se rechazó. Idempotente: repetir la llamada devuelve 204 sin reponer dos veces.",
        "operationId" : "liberar",
        "parameters" : [ {
          "name" : "reservaId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ReleaseRequest"
              }
            }
          }
        },
        "responses" : {
          "204" : {
            "description" : "Reserva liberada, o ya lo estaba"
          },
          "404" : {
            "description" : "No existe la reserva",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },
    "/internal/reservations/{reservaId}/confirm" : {
      "post" : {
        "tags" : [ "Inventario interno" ],
        "summary" : "Confirmar la venta",
        "description" : "Pasa la reserva de VIGENTE a CONFIRMADA si no venció y los asientos de RESERVADO a VENDIDO. Repetir una confirmada devuelve 200.",
        "operationId" : "confirmar",
        "parameters" : [ {
          "name" : "reservaId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Reserva confirmada, también si ya estaba CONFIRMADA",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ReservationResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "No existe la reserva",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problema"
                }
              }
            }
          },
          "409" : {
            "description" : "La reserva no se puede confirmar",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problema"
                }
              }
            }
          },
          "410" : {
            "description" : "La reserva venció",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problema"
                },
                "examples" : {
                  "RESERVATION_EXPIRED" : {
                    "description" : "RESERVATION_EXPIRED",
                    "value" : {
                      "type" : "https://ticketya.local/errors/reservation-expired",
                      "title" : "Gone",
                      "status" : 410,
                      "detail" : "La reserva está vencida y no se puede pagar",
                      "instance" : "/internal/reservations/b1c2d3e4-f5a6-4b7c-8d9e-0f1a2b3c4d5e/confirm",
                      "code" : "RESERVATION_EXPIRED",
                      "errors" : [ ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/internal/events/{eventoId}/inventory" : {
      "post" : {
        "tags" : [ "Inventario interno" ],
        "summary" : "Alta o actualización del inventario publicado",
        "description" : "Idempotente por eventoId + version. Reintentar la misma clave no duplica filas ni reinicia la disponibilidad ya vendida.\n",
        "operationId" : "upsert",
        "parameters" : [ {
          "name" : "eventoId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/InventoryUpsertRequest"
              },
              "example" : {
                "eventoId" : "d0000000-0000-4000-8000-000000000001",
                "nombre" : "Festival de Rock Tandil 2027",
                "fecha" : "2027-03-14T21:00:00-03:00",
                "limitePorCliente" : 4,
                "version" : 1,
                "sectores" : [ {
                  "sectorId" : "b0000000-0000-4000-8000-000000000001",
                  "nombre" : "Platea",
                  "tipo" : "NUMERADO",
                  "precio" : 25000.0,
                  "capacidad" : 20,
                  "filas" : 4,
                  "asientos" : [ {
                    "asientoId" : "c0000000-0000-4000-8000-010101000000",
                    "fila" : 1,
                    "numero" : 1
                  } ]
                } ]
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "Inventario guardado",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/InventoryUpsertResponse"
                },
                "example" : {
                  "eventoId" : "d0000000-0000-4000-8000-000000000001",
                  "sectores" : 2,
                  "asientos" : 20,
                  "idempotente" : true
                }
              }
            }
          },
          "400" : {
            "description" : "Cuerpo inválido",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problema"
                },
                "examples" : {
                  "VALIDATION_ERROR" : {
                    "description" : "VALIDATION_ERROR",
                    "value" : {
                      "type" : "https://ticketya.local/errors/validation-error",
                      "title" : "Bad Request",
                      "status" : 400,
                      "detail" : "La solicitud tiene campos inválidos",
                      "instance" : "/api/inventory/reservations",
                      "code" : "VALIDATION_ERROR",
                      "errors" : [ {
                        "field" : "items",
                        "message" : "un ítem numerado requiere asientoIds y no admite cantidad"
                      } ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/inventory/reservations" : {
      "post" : {
        "tags" : [ "Inventario público" ],
        "summary" : "Reservar asientos o lugares de una zona",
        "description" : "Todo o nada, durante 10 minutos. Un ítem numerado manda asientoIds y omite cantidad. Un ítem de zona manda cantidad y omite asientoIds. El cliente sale de X-User-Id. 409 si el asiento no está libre o la zona no alcanza. 422 CLIENT_LIMIT_EXCEEDED si vendidas más reservas vigentes más lo pedido superan limite_por_cliente.\n",
        "operationId" : "reservar",
        "parameters" : [ {
          "name" : "X-User-Id",
          "in" : "header",
          "description" : "UUID del cliente. Lo propaga el gateway.",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          },
          "example" : "2b3c4d5e-6f7a-4b8c-9d0e-1f2a3b4c5d6e"
        }, {
          "name" : "X-User-Role",
          "in" : "header",
          "description" : "CLIENT, ORGANIZER o ADMIN.",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "example" : "CLIENT"
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ReservaRequest"
              },
              "example" : {
                "eventoId" : "d0000000-0000-4000-8000-000000000001",
                "items" : [ {
                  "sectorId" : "b0000000-0000-4000-8000-000000000001",
                  "asientoIds" : [ "c0000000-0000-4000-8000-010101000000" ]
                } ]
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Reserva VIGENTE creada",
            "headers" : {
              "Location" : {
                "description" : "URL de la reserva",
                "style" : "simple",
                "schema" : {
                  "type" : "string"
                }
              }
            },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ReservationResponse"
                },
                "example" : {
                  "id" : "b1c2d3e4-f5a6-4b7c-8d9e-0f1a2b3c4d5e",
                  "eventoId" : "d0000000-0000-4000-8000-000000000001",
                  "eventoNombre" : "Festival de Rock Tandil 2027",
                  "eventoFecha" : "2027-03-14T21:00:00-03:00",
                  "clienteId" : "2b3c4d5e-6f7a-4b8c-9d0e-1f2a3b4c5d6e",
                  "estado" : "VIGENTE",
                  "expiresAt" : "2026-11-05T19:10:00-03:00",
                  "items" : [ {
                    "sectorId" : "b0000000-0000-4000-8000-000000000001",
                    "asientoId" : "c0000000-0000-4000-8000-010101000000",
                    "cantidad" : 1,
                    "precioUnitario" : 25000.0,
                    "subtotal" : 25000.0
                  } ],
                  "total" : 25000.0
                }
              }
            }
          },
          "400" : {
            "description" : "Cuerpo inválido",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problema"
                },
                "examples" : {
                  "VALIDATION_ERROR" : {
                    "description" : "VALIDATION_ERROR",
                    "value" : {
                      "type" : "https://ticketya.local/errors/validation-error",
                      "title" : "Bad Request",
                      "status" : 400,
                      "detail" : "La solicitud tiene campos inválidos",
                      "instance" : "/api/inventory/reservations",
                      "code" : "VALIDATION_ERROR",
                      "errors" : [ {
                        "field" : "items",
                        "message" : "un ítem numerado requiere asientoIds y no admite cantidad"
                      } ]
                    }
                  }
                }
              }
            }
          },
          "401" : {
            "description" : "Falta la identidad o X-User-Id no es un UUID",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problema"
                },
                "examples" : {
                  "UNAUTHORIZED" : {
                    "description" : "UNAUTHORIZED",
                    "value" : {
                      "type" : "https://ticketya.local/errors/unauthorized",
                      "title" : "Unauthorized",
                      "status" : 401,
                      "detail" : "Faltan los encabezados X-User-Id y X-User-Role",
                      "instance" : "/api/inventory/reservations",
                      "code" : "UNAUTHORIZED",
                      "errors" : [ ]
                    }
                  }
                }
              }
            }
          },
          "404" : {
            "description" : "No existe el evento o el sector",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problema"
                },
                "examples" : {
                  "EVENT_NOT_FOUND" : {
                    "description" : "EVENT_NOT_FOUND",
                    "value" : {
                      "type" : "https://ticketya.local/errors/event-not-found",
                      "title" : "Not Found",
                      "status" : 404,
                      "detail" : "No existe el evento d0000000-0000-4000-8000-000000000001",
                      "instance" : "/api/inventory/events/d0000000-0000-4000-8000-000000000001/availability",
                      "code" : "EVENT_NOT_FOUND",
                      "errors" : [ ]
                    }
                  },
                  "SECTOR_NOT_FOUND" : {
                    "description" : "SECTOR_NOT_FOUND",
                    "value" : {
                      "type" : "https://ticketya.local/errors/sector-not-found",
                      "title" : "Not Found",
                      "status" : 404,
                      "detail" : "No existe el sector b0000000-0000-4000-8000-000000000001 en el evento",
                      "instance" : "/api/inventory/events/d0000000-0000-4000-8000-000000000001/seats",
                      "code" : "SECTOR_NOT_FOUND",
                      "errors" : [ ]
                    }
                  }
                }
              }
            }
          },
          "409" : {
            "description" : "No se pudo reservar nada",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problema"
                },
                "examples" : {
                  "SEAT_NOT_AVAILABLE" : {
                    "description" : "SEAT_NOT_AVAILABLE",
                    "value" : {
                      "type" : "https://ticketya.local/errors/seat-not-available",
                      "title" : "Conflict",
                      "status" : 409,
                      "detail" : "El asiento c0000000-0000-4000-8000-010101000000 ya no está disponible",
                      "instance" : "/api/inventory/reservations",
                      "code" : "SEAT_NOT_AVAILABLE",
                      "errors" : [ ]
                    }
                  },
                  "INSUFFICIENT_AVAILABILITY" : {
                    "description" : "INSUFFICIENT_AVAILABILITY",
                    "value" : {
                      "type" : "https://ticketya.local/errors/insufficient-availability",
                      "title" : "Conflict",
                      "status" : 409,
                      "detail" : "No hay disponibilidad suficiente en la zona b0000000-0000-4000-8000-000000000002",
                      "instance" : "/api/inventory/reservations",
                      "code" : "INSUFFICIENT_AVAILABILITY",
                      "errors" : [ ]
                    }
                  },
                  "EVENT_NOT_ON_SALE" : {
                    "description" : "EVENT_NOT_ON_SALE",
                    "value" : {
                      "type" : "https://ticketya.local/errors/event-not-on-sale",
                      "title" : "Conflict",
                      "status" : 409,
                      "detail" : "El evento no está en venta",
                      "instance" : "/api/inventory/reservations",
                      "code" : "EVENT_NOT_ON_SALE",
                      "errors" : [ ]
                    }
                  }
                }
              }
            }
          },
          "422" : {
            "description" : "El cliente supera el límite de entradas del evento",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problema"
                },
                "examples" : {
                  "CLIENT_LIMIT_EXCEEDED" : {
                    "description" : "CLIENT_LIMIT_EXCEEDED",
                    "value" : {
                      "type" : "https://ticketya.local/errors/client-limit-exceeded",
                      "title" : "Unprocessable Entity",
                      "status" : 422,
                      "detail" : "El pedido supera el límite de entradas del cliente para este evento",
                      "instance" : "/api/inventory/reservations",
                      "code" : "CLIENT_LIMIT_EXCEEDED",
                      "errors" : [ ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
