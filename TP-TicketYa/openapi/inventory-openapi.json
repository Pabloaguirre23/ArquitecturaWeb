    "/api/inventory/reservations/{reservaId}" : {
      "get" : {
        "tags" : [ "Inventario público" ],
        "summary" : "Consultar una reserva propia",
        "description" : "Solo el dueño. Si la reserva venció, la respuesta es 200 con estado VENCIDA: 410 RESERVATION_EXPIRED se usa al confirmar o pagar, no en esta consulta.\n",
        "operationId" : "obtener",
        "parameters" : [ {
          "name" : "reservaId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "X-User-Id",
          "in" : "header",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          },
          "example" : "2b3c4d5e-6f7a-4b8c-9d0e-1f2a3b4c5d6e"
        }, {
          "name" : "X-User-Role",
          "in" : "header",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "example" : "CLIENT"
        } ],
        "responses" : {
          "200" : {
            "description" : "Reserva del cliente",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ReservationResponse"
                },
                "example" : {
