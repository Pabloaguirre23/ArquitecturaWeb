{"openapi":"3.1.0","info":{"title":"TicketYa - notification-service","description":"Notificaciones de TicketYa persistidas en PostgreSQL y alimentadas por RabbitMQ.\nLos endpoints públicos se consumen a través del gateway en /api/notifications/**.\nLa identidad llega como X-User-Id y X-User-Role; el cliente usa JWT contra el gateway.\nLa correlación de los eventos consumidos se persiste con cada notificación.\nTodos los errores usan RFC 7807 (application/problem+json) con code y errors[].\n","license":{"name":"Uso académico - UNICEN"},"version":"1.0.0"},"servers":[{"url":"http://localhost","description":"Generated server url"}],"tags":[{"name":"Notificaciones","description":"Consulta de las notificaciones propias del cliente"}],"paths":{"/api/notifications":{"get":{"tags":["Notificaciones"],"summary":"Listar mis notificaciones","description":"Devuelve solo las notificaciones del cliente autenticado, ordenadas por fecha descendente. Permite filtrar por estado y pagina con page/size.","operationId":"listar","parameters":[{"name":"page","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":0}},{"name":"size","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":20}},{"name":"estado","in":"query","required":false,"schema":{"type":"string","enum":["PENDIENTE","ENVIADA","FALLIDA"]}},{"name":"X-User-Id","in":"header","required":false,"schema":{"type":"string"}},{"name":"X-User-Role","in":"header","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Página de notificaciones propias","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PageResponseNotificacionResponse"}}}},"400":{"description":"Estado o paginación inválidos (VALIDATION_ERROR)","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"},"examples":{"VALIDATION_ERROR":{"summary":"Estado o paginación inválidos","value":{"type":"https://ticketya.local/errors/validation-error","title":"Bad Request","status":400,"detail":"La solicitud tiene parámetros inválidos","instance":"/api/notifications","code":"VALIDATION_ERROR","errors":[{"field":"estado","message":"valor inválido"}]}}}}}},"401":{"description":"Falta identidad (UNAUTHORIZED)","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"},"examples":{"UNAUTHORIZED":{"summary":"Falta identidad","value":{"type":"https://ticketya.local/errors/unauthorized","title":"Unauthorized","status":401,"detail":"Faltan los encabezados X-User-Id y X-User-Role","instance":"/api/notifications","code":"UNAUTHORIZED","errors":[]}}}}}},"403":{"description":"El rol no es CLIENT (FORBIDDEN)","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"},"examples":{"FORBIDDEN":{"summary":"Permiso insuficiente","value":{"type":"https://ticketya.local/errors/forbidden","title":"Forbidden","status":403,"detail":"El rol del usuario no puede consultar notificaciones","instance":"/api/notifications","code":"FORBIDDEN","errors":[]}}}}}}}}},"/api/notifications/{notificacionId}":{"get":{"tags":["Notificaciones"],"summary":"Consultar una notificación propia","description":"Devuelve el estado, los intentos y las fechas de una notificación del cliente autenticado. Una notificación de otro cliente responde 403.","operationId":"obtener","parameters":[{"name":"notificacionId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"X-User-Id","in":"header","required":false,"schema":{"type":"string"}},{"name":"X-User-Role","in":"header","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Notificación propia","content":{"*/*":{"schema":{"$ref":"#/components/schemas/NotificacionResponse"}}}},"401":{"description":"Falta identidad (UNAUTHORIZED)","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"},"examples":{"UNAUTHORIZED":{"summary":"Falta identidad","value":{"type":"https://ticketya.local/errors/unauthorized","title":"Unauthorized","status":401,"detail":"Faltan los encabezados X-User-Id y X-User-Role","instance":"/api/notifications","code":"UNAUTHORIZED","errors":[]}}}}}},"403":{"description":"Notificación de otro cliente (NOTIFICATION_FORBIDDEN)","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"},"examples":{"NOTIFICATION_FORBIDDEN":{"summary":"Notificación ajena","value":{"type":"https://ticketya.local/errors/notification-forbidden","title":"Forbidden","status":403,"detail":"La notificación pertenece a otro usuario","instance":"/api/notifications","code":"NOTIFICATION_FORBIDDEN","errors":[]}}}}}},"404":{"description":"La notificación no existe (NOTIFICATION_NOT_FOUND)","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"},"examples":{"NOTIFICATION_NOT_FOUND":{"summary":"Notificación inexistente","value":{"type":"https://ticketya.local/errors/notification-not-found","title":"Not Found","status":404,"detail":"No existe una notificación con el identificador indicado","instance":"/api/notifications","code":"NOTIFICATION_NOT_FOUND","errors":[]}}}}}}}}}},"components":{"schemas":{"NotificacionResponse":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"eventoId":{"type":"string","format":"uuid"},"tipo":{"type":"string"},"asunto":{"type":"string"},"contenido":{"type":"string"},"estado":{"type":"string","enum":["PENDIENTE","ENVIADA","FALLIDA"]},"intentos":{"type":"integer","format":"int32"},"proximoReintento":{"type":"string","format":"date-time"},"createdAt":{"type":"string","format":"date-time"},"enviadaAt":{"type":"string","format":"date-time"}}},"PageResponseNotificacionResponse":{"type":"object","properties":{"content":{"type":"array","items":{"$ref":"#/components/schemas/NotificacionResponse"}},"page":{"type":"integer","format":"int32"},"size":{"type":"integer","format":"int32"},"totalElements":{"type":"integer","format":"int64"},"totalPages":{"type":"integer","format":"int32"}}},"ProblemDetail":{"type":"object","description":"Error RFC 7807 con código de negocio y detalle por campo","properties":{"type":{"type":"string","example":"https://ticketya.local/errors/validation-error"},"title":{"type":"string","example":"Bad Request"},"status":{"type":"integer","format":"int32","example":400},"detail":{"type":"string","example":"La notificación pertenece a otro usuario"},"instance":{"type":"string","example":"/api/notifications/{notificacionId}"},"code":{"type":"string","example":"NOTIFICATION_FORBIDDEN"},"errors":{"type":"array","items":{"type":"object","properties":{"field":{"type":"string","example":"estado"},"message":{"type":"string","example":"valor inválido"}}}}}}},"responses":{"BadRequest":{"description":"Estado o paginación inválidos","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"},"examples":{"VALIDATION_ERROR":{"summary":"Estado o paginación inválidos","value":{"type":"https://ticketya.local/errors/validation-error","title":"Bad Request","status":400,"detail":"La solicitud tiene parámetros inválidos","instance":"/api/notifications","code":"VALIDATION_ERROR","errors":[{"field":"estado","message":"valor inválido"}]}}}}}},"Unauthorized":{"description":"Falta identidad","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"},"examples":{"UNAUTHORIZED":{"summary":"Falta identidad","value":{"type":"https://ticketya.local/errors/unauthorized","title":"Unauthorized","status":401,"detail":"Faltan los encabezados X-User-Id y X-User-Role","instance":"/api/notifications","code":"UNAUTHORIZED","errors":[]}}}}}},"Forbidden":{"description":"Permiso insuficiente","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"},"examples":{"FORBIDDEN":{"summary":"Permiso insuficiente","value":{"type":"https://ticketya.local/errors/forbidden","title":"Forbidden","status":403,"detail":"El rol del usuario no puede consultar notificaciones","instance":"/api/notifications","code":"FORBIDDEN","errors":[]}}}}}},"NotificationForbidden":{"description":"Notificación ajena","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"},"examples":{"NOTIFICATION_FORBIDDEN":{"summary":"Notificación ajena","value":{"type":"https://ticketya.local/errors/notification-forbidden","title":"Forbidden","status":403,"detail":"La notificación pertenece a otro usuario","instance":"/api/notifications","code":"NOTIFICATION_FORBIDDEN","errors":[]}}}}}},"NotFound":{"description":"Recurso inexistente","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"},"examples":{"NOT_FOUND":{"summary":"Recurso inexistente","value":{"type":"https://ticketya.local/errors/not-found","title":"Not Found","status":404,"detail":"El recurso solicitado no existe","instance":"/api/notifications","code":"NOT_FOUND","errors":[]}}}}}},"NotificationNotFound":{"description":"Notificación inexistente","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"},"examples":{"NOTIFICATION_NOT_FOUND":{"summary":"Notificación inexistente","value":{"type":"https://ticketya.local/errors/notification-not-found","title":"Not Found","status":404,"detail":"No existe una notificación con el identificador indicado","instance":"/api/notifications","code":"NOTIFICATION_NOT_FOUND","errors":[]}}}}}},"InternalServerError":{"description":"Error inesperado","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetail"},"examples":{"INTERNAL_ERROR":{"summary":"Error inesperado","value":{"type":"https://ticketya.local/errors/internal-error","title":"Internal Server Error","status":500,"detail":"Ocurrió un error inesperado en notification-service","instance":"/api/notifications","code":"INTERNAL_ERROR","errors":[]}}}}}}},"securitySchemes":{"bearerAuth":{"type":"http","description":"JWT emitido por POST /api/auth/login del gateway","scheme":"bearer","bearerFormat":"JWT"},"X-User-Id":{"type":"apiKey","description":"UUID del usuario autenticado, propagado por el gateway","name":"X-User-Id","in":"header"},"X-User-Role":{"type":"apiKey","description":"Rol del usuario: CLIENT, ORGANIZER, ADMIN o ACCESS_STAFF","name":"X-User-Role","in":"header"},"X-Correlation-Id":{"type":"apiKey","description":"Identificador de correlación del sobre de eventos; se persiste con la notificación y no es obligatorio en la consulta","name":"X-Correlation-Id","in":"header"}}}}