          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test('trae token y rol', function () { pm.expect(body.token).to.be.a('string').and.not.empty; pm.expect(body.role).to.eql('ADMIN'); });",
                  "pm.collectionVariables.set('tokenAdmin', body.token);"
