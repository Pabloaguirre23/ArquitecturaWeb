    {
      "name": "Catálogo",
      "description": "Dueño: Iván (P1). Lugares, sectores, eventos, precios, publicar y cancelar, con el rol que corresponde.",
      "item": [
        {
          "name": "Buscar eventos (público)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/catalog/events?size=5"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 y página', function () { pm.response.to.have.status(200); var b = pm.response.json(); pm.expect(b.content).to.be.an('array'); if (b.content.length) { pm.collectionVariables.set('eventoId', b.content[0].id); } });"
                ]
              }
            }
          ]
        },
        {
          "name": "Detalle del evento",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/catalog/events/{{eventoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 con sectores', function () { pm.response.to.have.status(200); var b = pm.response.json(); pm.expect(b.sectores).to.be.an('array'); var zona = b.sectores.find(function (s) { return s.tipo === 'NO_NUMERADO'; }); if (zona) { pm.collectionVariables.set('sectorId', zona.sectorId); } });"
                ]
              }
            }
          ]
        }
      ]
    },
